// --- 2. RRG計算ロジック ---
f_rrg(sym, b_ticker, length) =>
    s_close = request.security(sym, timeframe.period, close, ignore_invalid_symbol=true)
    b_close = request.security(b_ticker, timeframe.period, close, ignore_invalid_symbol=true)
    rs = s_close / b_close
    
    dev1 = ta.stdev(rs, length)
    dev1 := dev1 == 0 or na(dev1) ? 0.0001 : dev1
    rs_ratio = 100 + ((rs - ta.sma(rs, length)) / dev1) * 3
    
    dev2 = ta.stdev(rs_ratio, length)
    dev2 := dev2 == 0 or na(dev2) ? 0.0001 : dev2
    rs_mom = 100 + ((rs_ratio - ta.sma(rs_ratio, length)) / dev2) * 3
    
    [rs_ratio, rs_mom]

