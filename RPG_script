var rrg_labels = array.new<label>()
var legend_tbl = table.new(position.top_right, 3, 20, bgcolor=color.new(color.black, 30), border_color=color.gray, border_width=1)

f_draw(show, name_str, r, m, col, origin_x, row_idx) =>
    if show and barstate.islast and not na(r[0]) and not na(m[0])
        for i = tail_len - 1 to 0
            if not na(r[i+1]) and not na(m[i+1]) and not na(r[i]) and not na(m[i])
                x_past = origin_x + (r[i+1] - 100) * x_mult
                y_past = m[i+1]
                x_curr = origin_x + (r[i] - 100) * x_mult
                y_curr = m[i]
                x_past_int = int(x_past)
                x_curr_int = int(x_curr)
                
                ratio = float(i) / tail_len
                transp = int(ratio * 85)
                line_col = color.new(col, transp)
                line_width = i < 4 ? 2 : 1
                
                array.push(rrg_lines, line.new(x_past_int, y_past, x_curr_int, y_curr, color=line_col, width=line_width))
                
                if i > 0 and (i <= 3 or i % 3 == 0 or i == tail_len - 1)
                    point_x = i <= 3 ? x_curr_int : x_past_int
                    point_y = i <= 3 ? y_curr : y_past
                    array.push(rrg_labels, label.new(point_x, point_y, "●", style=label.style_none, textcolor=line_col, size=size.tiny))

        x_now = origin_x + (r[0] - 100) * x_mult
        y_now = m[0]
        array.push(rrg_labels, label.new(int(x_now), y_now, "", style=label.style_circle, color=col, size=size.tiny))

        if show_table and row_idx > 0
            [quad_str, quad_col] = f_quad_info(r[0], m[0])
            table.cell(legend_tbl, 0, row_idx, "", bgcolor=col, width=2)
            table.cell(legend_tbl, 1, row_idx, name_str, text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(legend_tbl, 2, row_idx, quad_str, text_color=quad_col, text_size=size.small, text_halign=text.align_left)

