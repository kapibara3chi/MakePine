// --- 象限名判定関数 ---
f_quad_info(r, m) =>
    if r >= 100 and m >= 100
        ["Leading (先行)", color.green]
    else if r < 100 and m >= 100
        ["Improving (改善)", color.blue]
    else if r < 100 and m < 100
        ["Lagging (遅行)", color.red]
    else
        ["Weakening (衰退)", color.orange]

// --- 4. 描画用配列とオブジェクト ---
